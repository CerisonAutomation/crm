datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedCompanies Company[]           @relation("CompanyOwner")
  ownedContacts  Contact[]           @relation("ContactOwner")
  ownedDeals     Deal[]              @relation("DealOwner")
  activities     Activity[]          @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[]       @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  fieldValues    FieldValue[]        @relation("FieldValueUser")
  savedViews     SavedView[]         @relation("SavedViewOwner")
  appointmentTypes      AppointmentType[]
  bookings              Booking[]
  connectedAccounts     ConnectedAccount[]
  channelMessages       ChannelMessage[]
  sendClaims            SendClaim[]
  agentRunReceipts      AgentRunReceipt[]
  agentActionDrafts     AgentActionDraft[]
  agentReflectionEvents AgentReflectionEvent[]
  agentTasteSessions    AgentTasteSession[]
  evalRuns              EvalRun[]
  brains                Brain[]
  soulProfiles          SoulProfile[]
  workspaceSecrets      WorkspaceSecret[]
  workspaceDomains      WorkspaceDomain[]
  portalAccessCodes     PortalAccessCode[]
  suppressionEntries    SuppressionEntry[]
  ownedApplicationCases ApplicationCase[]

  createdAgentDefinitions AgentDefinition[]             @relation("AgentDefinitionCreator")
  createdAgentVersions    AgentVersion[]                @relation("AgentVersionCreator")
  createdAgentTriggers    AgentTrigger[]                @relation("AgentTriggerCreator")
  initiatedAgentRuns      AgentRun[]                    @relation("AgentRunInitiator")
  agentAuditEvents        AgentAuditEvent[]             @relation("AgentAuditActor")
  conversationShares      AgentConversationShare[]      @relation("ConversationShareCreator")
  conversationSubmissions AgentConversationSubmission[] @relation("ConversationSubmissionAuthor")
  conversationFeedback    AgentConversationFeedback[]   @relation("ConversationFeedbackAuthor")
  slackMemberMatch        SlackMemberMatch?

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  apiKeys Apikey[]

  @@unique([email])
  @@map("user")
}

model SlackMemberMatch {
  id          String   @id @default(cuid())
  crmUserId   String   @unique
  crmUser     User     @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  slackUserId String?
  slackHandle String?
  slackEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slackUserId])
  @@map("slackMemberMatch")
}

model SlackChannel {
  id                String    @id
  name              String
  memberCount       Int?
  available         Boolean   @default(true)
  isPrivate         Boolean   @default(false)
  isMember          Boolean   @default(false)
  inviteRequestedAt DateTime?
  classifiedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([available, name])
  @@index([updatedAt])
  @@map("slackChannel")
}

model SlackInstallation {
  installerId String   @id
  teamId      String
  teamName    String?
  userToken   String?
  userScopes  String
  createdAt   DateTime @default(now())

  @@map("slackInstallation")
}

model SlackWorkspaceGrant {
  id         String   @id @default(cuid())
  teamId     String   @unique
  teamName   String?
  userToken  String
  userScopes String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("slackWorkspaceGrant")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  TRACKING
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentResponseRating {
  UP
  DOWN
}

model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String?
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?
  archivedAt     DateTime?

  contacts       Contact[]           @relation("CompanyContacts")
  conversations  AgentConversation[]
  deals          Deal[]
  activities     Activity[]
  emailThreads   EmailThread[]
  calendarEvents CalendarEvent[]
  applicationCases ApplicationCase[]
  dueDiligenceProfiles DueDiligenceProfile[]
  fieldValues    FieldValue[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([domain], map: "company_domain_active_key", where: { archivedAt: null })
  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@map("company")
}

model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String?
  seniority   String?
  function    String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?
  archivedAt     DateTime?

  deals           DealContact[]
  activities      Activity[]
  emailThreads    EmailThread[]
  calendarEvents  CalendarEvent[]
  eventAttendance CalendarAttendee[]
  fieldValues     FieldValue[]
  visitors        TrackedVisitor[]   @relation("VisitorContact")
  submissions     FormSubmission[]   @relation("SubmissionContact")
  applicationCases ApplicationCase[]
  screeningRuns ScreeningRun[]
  dueDiligenceProfiles DueDiligenceProfile[]
  eligibilityAssessments EligibilityAssessment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([email], map: "contact_email_active_key", where: { archivedAt: null })
  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@map("contact")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

model AgentTask {
  id        String  @id @default(cuid())
  contactId String?
  companyId String?
  dealId    String?

  kind    String
  reason  String
  payload Json?

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  subject String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([dealId])
  @@index([kind, subject], where: { finishedAt: null })
  @@map("agentTask")
}

model AgentEvent {
  id             String             @id
  sessionId      String
  contactId      String?
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  data           Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@index([conversationId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  sessionId           String? @unique
  continuationToken   String?
  streamIndex         Int     @default(0)
  pendingInputRequest Json?

  title        String?
  messageCount Int     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime  @default(now())
  lastAssistantAt DateTime?
  lastReadAt      DateTime?

  shares           AgentConversationShare[]
  submissions      AgentConversationSubmission[]
  feedback         AgentConversationFeedback[]
  events           AgentEvent[]
  createdVersions  AgentVersion[]                @relation("AgentVersionSourceConversation")
  builderArtifacts AgentBuilderArtifact[]

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@map("agentConversation")
}

model AgentConversationFeedback {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  rating    AgentResponseRating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
  @@map("agentConversationFeedback")
}

model AgentConversationShare {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ConversationShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  scope     AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash String                      @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([conversationId], map: "agentConversationShare_one_active_per_conversation", where: { revokedAt: null })
  @@index([conversationId, revokedAt])
  @@map("agentConversationShare")
}

model AgentConversationSubmission {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ConversationSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  clientRequestId String                            @unique
  inputRequestId  String?
  commandType     AgentConversationCommandType      @default(CHAT)
  message         Json
  status          AgentConversationSubmissionStatus @default(PENDING)
  attemptCount    Int                               @default(0)

  errorCode    String?
  errorMessage String?

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?

  attachments AgentConversationAttachment[]

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("agentConversationSubmission")
}

model AgentConversationAttachment {
  id String @id @default(cuid())

  submissionId String
  submission   AgentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  content   Bytes
  position  Int

  createdAt DateTime @default(now())

  @@index([submissionId, position])
  @@map("agentConversationAttachment")
}

model AgentDefinition {
  id String @id @default(cuid())

  name        String
  description String?
  status      AgentDefinitionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("AgentDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("CurrentAgentVersion", fields: [currentVersionId, id], references: [id, agentId], onDelete: Restrict)

  versions      AgentVersion[]      @relation("AgentVersions")
  triggers      AgentTrigger[]
  runs          AgentRun[]
  actions       AgentAction[]
  auditEvents   AgentAuditEvent[]
  conversations AgentConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@unique([currentVersionId, id])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@map("agentDefinition")
}

model AgentVersion {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Restrict)

  number Int
  status AgentVersionStatus @default(DRAFT)

  instructions             String
  manifest                 Json
  modelId                  String
  modelContextWindowTokens Int    @default(1000000)
  sandboxPolicy            Json
  validation               Json?

  sourceConversationId String?
  sourceConversation   AgentConversation? @relation("AgentVersionSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AgentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  deploymentId String?
  approvedAt   DateTime?
  deployedAt   DateTime?
  createdAt    DateTime  @default(now())

  currentFor       AgentDefinition?       @relation("CurrentAgentVersion")
  triggers         AgentTrigger[]
  runs             AgentRun[]
  auditEvents      AgentAuditEvent[]
  builderArtifacts AgentBuilderArtifact[]

  @@unique([agentId, number])
  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@map("agentVersion")
}

model AgentBuilderArtifact {
  id String @id @default(cuid())

  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  path            String
  language        String
  content         String
  previousContent String?
  revision        Int
  status          AgentBuilderArtifactStatus @default(WRITING)
  createdAt       DateTime                   @default(now())

  @@unique([conversationId, path, revision], map: "agentBuilderArtifact_conversation_path_revision_key", where: { conversationId: { not: null } })
  @@unique([versionId, path, revision], map: "agentBuilderArtifact_version_path_revision_key", where: { versionId: { not: null } })
  @@index([conversationId, createdAt])
  @@index([versionId, path])
  @@map("agentBuilderArtifact")
}

model AgentTrigger {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  type   AgentTriggerType
  name   String
  config Json

  createdById String
  createdBy   User   @relation("AgentTriggerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  enabled   Boolean   @default(false)
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runs AgentRun[]

  @@unique([id, agentId])
  @@index([agentId, enabled])
  @@index([enabled, nextRunAt])
  @@index([versionId])
  @@map("agentTrigger")
}

model AgentRun {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  triggerId String?
  trigger   AgentTrigger? @relation(fields: [triggerId, agentId], references: [id, agentId], onDelete: Restrict)

  initiatedById String?
  initiatedBy   User?   @relation("AgentRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  triggerType    AgentTriggerType
  status         AgentRunStatus   @default(QUEUED)
  principalId    String?
  sessionId      String?          @unique
  idempotencyKey String           @unique
  correlationId  String           @unique

  input   Json?
  result  Json?
  summary String?

  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  errorCode    String?
  errorMessage String?

  nextEventSequence Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  cancelRequestedAt DateTime?
  cancelDeliveredAt DateTime?

  events  AgentRunEvent[]
  actions AgentAction[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([versionId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@map("agentRun")
}

model AgentRunEvent {
  id String @id @default(cuid())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  sequence  Int
  type      String
  data      Json
  emittedAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, emittedAt])
  @@map("agentRunEvent")
}

model AgentAction {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  runId String
  run   AgentRun @relation(fields: [runId, agentId], references: [id, agentId], onDelete: Restrict)

  type        String
  provider    String
  targetType  String?
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?

  status         AgentActionStatus @default(PLANNED)
  idempotencyKey String            @unique
  requestHash    String?
  externalId     String?
  attemptCount   Int               @default(0)

  errorCode    String?
  errorMessage String?

  plannedAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([agentId, plannedAt])
  @@index([runId, plannedAt])
  @@index([provider, externalId])
  @@index([status, plannedAt])
  @@map("agentAction")
}

model AgentAuditEvent {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  actorUserId String?
  actorUser   User?   @relation("AgentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  type      String
  actorType String
  actorId   String?
  summary   String
  before    Json?
  after     Json?
  requestId String?
  emittedAt DateTime @default(now())

  @@unique([agentId, type, requestId])
  @@index([agentId, emittedAt])
  @@index([versionId, emittedAt])
  @@index([actorUserId, emittedAt])
  @@index([type, emittedAt])
  @@map("agentAuditEvent")
}

model Deal {
  id            String              @id @default(cuid())
  conversations AgentConversation[]
  name          String
  description   String?
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                @relation("DealOwner", fields: [ownerId], references: [id])

  stage             DealStage @default(DEMO_BOOKED)
  stageChangedAt    DateTime  @default(now())
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  lastActivityAt DateTime?
  archivedAt     DateTime?

  contacts    DealContact[]
  activities  Activity[]
  fieldValues FieldValue[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@index([baseAmount])
  @@index([currency])
  @@index([archivedAt])
  @@map("deal")
}

enum RateSource {
  FETCHED
  MANUAL
}

model ExchangeRate {
  id            String     @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(20, 10)
  asOf          DateTime
  source        RateSource
  provider      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([baseCurrency, quoteCurrency, source])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchangeRate")
}

model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String?

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("dealContact")
}

enum FieldEntity {
  COMPANY
  CONTACT
  DEAL
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  URL
  EMAIL
  PHONE
  USER
}

model FieldDefinition {
  id     String      @id @default(cuid())
  entity FieldEntity
  key    String
  label  String
  type   FieldType

  agentFilled Boolean @default(true)
  agentBrief  String?

  required     Boolean @default(false)
  showOnSheet  Boolean @default(true)
  showOnTable  Boolean @default(false)
  showOnFilter Boolean @default(false)
  position     Int

  archivedAt DateTime?

  options FieldOption[]
  values  FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, key])
  @@index([entity, position])
  @@map("fieldDefinition")
}

model FieldOption {
  id       String          @id @default(cuid())
  fieldId  String
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label    String
  position Int

  archivedAt DateTime?
  values     FieldValue[]

  @@index([fieldId, position])
  @@map("fieldOption")
}

model FieldValue {
  id      String          @id @default(cuid())
  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  text     String?
  number   Decimal?     @db.Decimal(24, 4)
  date     DateTime?
  bool     Boolean?
  optionId String?
  option   FieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?        @relation("FieldValueUser", fields: [userId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([fieldId, companyId])
  @@unique([fieldId, contactId])
  @@unique([fieldId, dealId])
  @@index([fieldId, text])
  @@index([fieldId, number])
  @@index([fieldId, date])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([optionId])
  @@index([userId])
  @@map("fieldValue")
}

model SavedView {
  id      String      @id @default(cuid())
  entity  FieldEntity
  name    String
  shared  Boolean     @default(false)
  filters Json

  ownerId String
  owner   User   @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, ownerId, name])
  @@index([entity, shared])
  @@map("savedView")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  occurredAt  DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  meta        Json?

  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([createdById])
  @@map("activity")
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  NEEDS_RECONNECT
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String

  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
}

model EmailThread {
  id            String  @id @default(cuid())
  rootMessageId String  @unique
  subject       String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  rfcMessageId     String  @unique
  syncedByUserId   String?
  gmailMessageId   String?
  outlookMessageId String?
  outlookWebLink   String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  recipients Json
  subject    String?
  snippet    String?
  body       String?
  sentAt     DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
}

model CalendarEvent {
  id                String   @id @default(cuid())
  iCalUid           String
  originalStartTime DateTime
  recurringEventId  String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
}

model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
}

model SuppressedContact {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedContact")
}

model AppSetting {
  id String @id

  agentModelId String?

  agentModelContextWindow Int?

  contextDevApiKey String?

  reportingCurrency String?

  ratesRefreshedAt DateTime?

  archiveRetentionDays Int @default(180)

  trackingSiteId           String? @unique
  trackingCrossDomain      Boolean @default(true)
  trackingLimitToDomains   Boolean @default(true)
  trackingCookieSubdomains Boolean @default(false)
  trackingSecureCookies    Boolean @default(true)
  trackingHonourDnt        Boolean @default(true)
  trackingCookieDays       Int     @default(395)
  trackingConfigHash       String?
  trackingPaused           Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("appSetting")
}

enum DomainScope {
  SITE_AND_SUBDOMAINS
  EXACT_HOST
}

model TrackedDomain {
  id    String      @id @default(cuid())
  host  String      @unique
  scope DomainScope @default(EXACT_HOST)

  pageViews  Int       @default(0)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  @@map("trackedDomain")
}

model TrackedVisitor {
  id String @id

  contactId String?
  contact   Contact? @relation("VisitorContact", fields: [contactId], references: [id], onDelete: SetNull)

  firstSource   String?
  firstMedium   String?
  firstCampaign String?
  firstTerm     String?
  firstContent  String?
  firstReferrer String?
  firstLanding  String?
  firstTouchAt  DateTime?

  lastSource   String?
  lastMedium   String?
  lastCampaign String?
  lastTerm     String?
  lastContent  String?
  lastReferrer String?
  lastLanding  String?
  lastTouchAt  DateTime?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@index([contactId])
  @@index([firstSource])
  @@map("trackedVisitor")
}

model TrackedEvent {
  id String @id @default(cuid())

  visitorId String
  type      String
  host      String
  path      String
  referrer  String?
  label     String?

  source   String?
  medium   String?
  campaign String?

  occurredAt DateTime

  @@index([visitorId, occurredAt])
  @@index([occurredAt])
  @@index([host, occurredAt])
  @@index([source, occurredAt])
  @@map("trackedEvent")
}

model TrackingCounter {
  key       String   @id
  value     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("trackingCounter")
}

model TrackedPageDaily {
  day      DateTime
  host     String
  path     String
  views    Int      @default(0)
  visitors Int      @default(0)

  @@id([day, host, path])
  @@index([host, day])
  @@map("trackedPageDaily")
}

model FormSubmission {
  id String @id @default(cuid())

  visitorId String?
  contactId String?
  contact   Contact? @relation("SubmissionContact", fields: [contactId], references: [id], onDelete: SetNull)

  host  String
  path  String
  email String?

  fields Json

  firstTouch Json?
  lastTouch  Json?

  dedupeKey  String    @unique
  filedAt    DateTime?
  skipReason String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([createdAt])
  @@map("formSubmission")
}

model Install {
  id String @id

  uuid    String @unique
  version String

  lastRollupAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("install")
}

model TelemetryMilestone {
  step      String   @id
  reachedAt DateTime @default(now())

  @@map("telemetryMilestone")
}

model TelemetryCounter {
  name      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("telemetryCounter")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  website     String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model WorkspaceProfile {
  id String @id

  website   String
  narrative String
  sections  Json

  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("workspaceProfile")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?  
  start               String?  
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  prefix              String?  
  key                 String
  refillInterval      Int?     
  refillAmount        Int?     
  lastRefillAt        DateTime? 
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?     
  rateLimitMax        Int?     
  requestCount        Int?      @default(0)
  remaining           Int?     
  lastRequest         DateTime? 
  expiresAt           DateTime? 
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?  
  metadata            String?  

  @@index([referenceId])
  @@index([configId])
  @@index([key])
  @@map("apikey")
}

// ════════════════════════════════════════════════════════════════════════════════
// Citizen Lane models — converted from twenty-apps/internal/citizen-lane/src/objects
// ════════════════════════════════════════════════════════════════════════════════

enum CaseStage {
  ASSESSMENT
  AGREEMENT
  PAYMENT
  DOCUMENT_COLLECTION
  RM_REVIEW
  PREPARING_SUBMISSION
  SUBMITTED
  ON_HOLD
  CLOSED
}

enum DocumentReviewStatus {
  REQUESTED
  UPLOADED
  NEEDS_INFORMATION
  APPROVED
  EXPIRED
}

enum ScreeningRunStatus {
  QUEUED
  RUNNING
  REVIEW_REQUIRED
  CLEARED
  FAILED
  CANCELLED
}

enum DueDiligenceStatus {
  NOT_STARTED
  IN_REVIEW
  INFORMATION_REQUIRED
  APPROVED
  DECLINED
  EXPIRED
}

enum DueDiligenceLevel {
  SDD
  CDD
  EDD
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  PROVISIONAL
  REVIEWED
  CLOSED
}

enum AssessmentOutcome {
  VERY_HIGH
  HIGH
  MEDIUM
  VERY_LOW
  BESPOKE_REVIEW
}

enum ProviderConnectionStatus {
  DRAFT
  PENDING_APPROVAL
  ENABLED
  PAUSED
  RETIRED
}

enum RouteStatus {
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  ESCALATED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum RunStatus {
  RUNNING
  WAITING_APPROVAL
  WAITING_WORKFLOW
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NodeRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  WAITING_APPROVAL
  WAITING_WORKFLOW
  SKIPPED
}

enum WaitpointStatus {
  WAITING
  RESUMED
  EXPIRED
  CANCELLED
}

enum WaitpointKind {
  APPROVAL
  TIMER
  EVENT
  CALLBACK
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  INFO
  BLOCKED
}

model ApplicationCase {
  id            String      @id @default(cuid())
  reference     String      @unique
  routeName     String
  stage         CaseStage   @default(ASSESSMENT)
  mainApplicantCount Int    @default(1)
  dependentCount Int        @default(0)
  agreementSignedAt DateTime?
  paymentStatus   String?
  nextClientAction String?
  nextAuthorityFollowUpAt DateTime?

  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  documents     CaseDocument[]
  screeningRuns ScreeningRun[]
  dueDiligenceProfiles DueDiligenceProfile[]
  eligibilityAssessments EligibilityAssessment[]
  workItems     WorkItem[]
  workflowRuns  WorkflowRun[]
  auditEvents   AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([routeName])
  @@index([stage])
  @@index([contactId])
  @@index([companyId])
  @@index([ownerId])
  @@map("applicationCase")
}

model CaseDocument {
  id           String @id @default(cuid())
  name         String
  documentType String
  reviewStatus DocumentReviewStatus @default(REQUESTED)
  files        String?
  issuedAt     DateTime?
  validUntil   DateTime?
  rmComment    String?
  reviewedAt   DateTime?

  caseId String
  case   ApplicationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([reviewStatus])
  @@map("caseDocument")
}

model ScreeningRun {
  id                String @id @default(cuid())
  reference         String @unique
  provider          String
  providerReference String?
  status            ScreeningRunStatus @default(QUEUED)
  screeningType     String?
  resultSummary     String?
  complianceDisposition String?
  requestedAt       DateTime?
  completedAt       DateTime?

  caseId    String?
  case      ApplicationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([caseId])
  @@index([contactId])
  @@map("screeningRun")
}

model DueDiligenceProfile {
  id                String @id @default(cuid())
  reference         String @unique
  status            DueDiligenceStatus @default(NOT_STARTED)
  level             DueDiligenceLevel @default(CDD)
  riskRating        String?
  riskRationale     String?
  pepStatus         String?
  sanctionsStatus   String?
  sourceOfFunds     String?
  sourceOfWealth    String?
  reviewedAt        DateTime?
  nextReviewAt      DateTime?
  reviewDecision    String?
  evidenceFiles     String?

  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  caseId    String?
  case      ApplicationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([contactId])
  @@index([companyId])
  @@map("dueDiligenceProfile")
}

model EligibilityAssessment {
  id                String @id @default(cuid())
  reference         String @unique
  routeName         String
  status            AssessmentStatus @default(DRAFT)
  provisionalOutcome AssessmentOutcome?
  evidenceAvailable Boolean @default(false)
  questionnaireNotes String?
  rmDecision        String?
  reviewedAt        DateTime?

  caseId    String?
  case      ApplicationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([caseId])
  @@index([contactId])
  @@map("eligibilityAssessment")
}

model ProviderConnection {
  id               String @id @default(cuid())
  name             String
  provider         String
  status           ProviderConnectionStatus @default(DRAFT)
  permittedPurposes String
  dataResidency    String?
  approvalReference String?
  lastHealthCheckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@map("providerConnection")
}

model ServiceRoute {
  id          String @id @default(cuid())
  name        String
  country     String
  category    String
  summary     String?
  entryCriteria String?
  status      RouteStatus @default(DRAFT)
  sortOrder   Int?
  publiclyVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([category])
  @@index([status])
  @@map("serviceRoute")
}

model WorkItem {
  id           String @id @default(cuid())
  title        String
  status       WorkItemStatus @default(TODO)
  priority     WorkItemPriority @default(NORMAL)
  type         String
  workflowRunId String?
  nodeRunId    String?
  requiredRole String?
  assignedTo   String?
  body         String?
  dueDate      DateTime?
  completedAt  DateTime?
  decision     String?
  decisionReason String?
  decisionBy   String?

  caseIdRef    String?
  case         ApplicationCase? @relation(fields: [caseIdRef], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([caseIdRef])
  @@index([assignedTo])
  @@map("workItem")
}

model Workflow {
  id           String @id @default(cuid())
  name         String
  status       WorkflowStatus @default(DRAFT)
  version      Int
  triggerPieceKey String?
  graphNodes   String?
  graphEdges   String?
  templateKey  String?
  orgId        String?
  disabled     Boolean @default(false)
  createdBy    String?

  runs WorkflowRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([templateKey])
  @@index([orgId])
  @@map("workflow")
}

model WorkflowRun {
  id        String @id @default(cuid())
  runId     String @unique
  status    RunStatus @default(RUNNING)
  workflowId String?
  version   Int
  caseId    String?
  trigger   String
  context   String?
  error     String?
  startedAt DateTime
  finishedAt DateTime?
  attempts  Int @default(0)

  workflow  Workflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  case      ApplicationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  nodeRuns   WorkflowNodeRun[]
  waitpoints WorkflowWaitpoint[]
  waits      WorkflowWait[]
  approvals  WorkflowApproval[]
  stepResults WorkflowStepResult[]
  eventLogs  WorkflowEventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([status])
  @@index([workflowId])
  @@index([caseId])
  @@map("workflowRun")
}

model WorkflowNodeRun {
  id           String @id @default(cuid())
  nodeKey      String
  pieceKey     String
  name         String
  workflowRunId String
  status       NodeRunStatus @default(RUNNING)
  inputPreview String?
  outputPreview String?
  error        String?
  attempts     Int @default(0)
  startedAt    DateTime
  finishedAt   DateTime?
  approvalDecision String?
  decisionReason String?
  approverId   String?

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  waitpoints WorkflowWaitpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowRunId])
  @@index([status])
  @@map("workflowNodeRun")
}

model WorkflowWaitpoint {
  id             String @id @default(cuid())
  runId          String
  nodeRunId      String
  kind           WaitpointKind @default(APPROVAL)
  resumeToken    String @unique
  eventKind      String?
  expiresAt      DateTime
  contextSnapshot String?
  status         WaitpointStatus @default(WAITING)
  resumedBy      String?
  resumedAt      DateTime?
  resumePayload  String?

  workflowRun WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeRun     WorkflowNodeRun @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([nodeRunId])
  @@index([resumeToken])
  @@index([status])
  @@index([expiresAt])
  @@map("workflowWaitpoint")
}

model WorkflowStepClaim {
  id      String @id @default(cuid())
  scope   String
  key     String
  claimedAt DateTime

  @@unique([scope, key])
  @@index([scope])
  @@map("workflowStepClaim")
}

model AuditEvent {
  id          String @id @default(cuid())
  action      String
  outcome     AuditOutcome @default(SUCCESS)
  actor       String
  actorId     String?
  targetId    String?
  targetType  String?
  before      String?
  after       String?
  reason      String?
  correlationId String?
  occurredAt  DateTime

  caseId String?
  case   ApplicationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([outcome])
  @@index([actor])
  @@index([caseId])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("auditEvent")
}
model AppointmentType {
	id               String   @id @default(uuid())
	ownerUserId      String?
	slug             String
	title            String
	description      String?
	durationMinutes  Int      @default(30)
	bufferMinutes    Int      @default(0)
	timezone         String   @default("UTC")
	availability     Json
	provider         String   @default("manual")
	meetingProvider  String   @default("none")
	color            String?
	enabled          Boolean  @default(true)
	createdAt        DateTime @default(now())
	updatedAt        DateTime @updatedAt
	owner            User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
	bookings         Booking[]

	@@unique([ownerUserId, slug])
	@@index([ownerUserId])
	@@index([enabled])
}

model Booking {
	id              String   @id @default(uuid())
	appointmentTypeId String?
	ownerUserId     String?
	contactId       String?
	title           String
	fullName        String?
	email           String?
	notes           String?
	provider        String   @default("manual")
	status          String   @default("scheduled")
	startsAt        DateTime
	endsAt          DateTime
	meetingUrl      String?
	externalEventId String?
	metadata        Json     @default("{}")
	cancelledAt     DateTime?
	completedAt     DateTime?
	createdAt       DateTime @default(now())
	updatedAt       DateTime @updatedAt
	appointmentType AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)
	owner           User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

	@@index([ownerUserId, startsAt])
	@@index([status, startsAt])
	@@index([externalEventId])
}


enum WorkflowWaitStatus {
	active
	resumed
	timed_out
	cancelled
}

enum WorkflowWaitResumeReason {
	event_match
	timeout
	manual
	cancelled
}

model WorkflowWait {
	id             String                  @id @default(uuid())
	runId          String
	stepName       String
	matchEvent     String
	matchPredicate Json
	timeoutAt      DateTime?
	status         WorkflowWaitStatus      @default(active)
	resumedAt      DateTime?
	resumedByRunEventId String?
	resumedReason  WorkflowWaitResumeReason?
	createdAt      DateTime                @default(now())
	updatedAt      DateTime                @updatedAt
	run            WorkflowRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@index([status, timeoutAt])
	@@index([runId, stepName])
	@@index([matchEvent, status])
}

enum WorkflowApprovalStatus {
	pending
	approved
	rejected
	timed_out
	cancelled
}

model WorkflowApproval {
	id               String                  @id @default(uuid())
	runId            String
	stepName         String
	requestedByUserId String?
	approverHint     String?
	reason           String
	payload          Json                    @default("{}")
	status           WorkflowApprovalStatus @default(pending)
	timeoutAt        DateTime?
	resolvedByUserId String?
	resolvedAt       DateTime?
	resolutionNote   String?
	createdAt        DateTime                @default(now())
	updatedAt        DateTime                @updatedAt
	run              WorkflowRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@index([status, timeoutAt])
	@@index([runId, stepName])
}


enum SendClaimOutcome {
	unknown
	sent
	failed
}

model SendClaim {
	id              String          @id @default(uuid())
	ownerUserId     String?
	workflowRunId   String?
	channel         String
	kind            String
	stepNumber      Int
	idempotencyKey  String
	outcome         SendClaimOutcome @default(unknown)
	providerReference String?
	claimedAt       DateTime        @default(now())
	resolvedAt      DateTime?
	lastError       String?
	owner           User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

	@@unique([channel, kind, stepNumber, idempotencyKey])
	@@index([outcome, claimedAt])
	@@index([ownerUserId])
}


enum ConnectedAccountStatus {
	pending
	active
	expired
	revoked
	error
}

model ConnectedAccount {
	id           String                  @id @default(uuid())
	ownerUserId  String?
	provider     String
	handle       String
	displayName  String?
	status       ConnectedAccountStatus  @default(pending)
	scopes       String[]                @default([])
	accessToken  String?
	refreshToken String?
	expiresAt    DateTime?
	metadata     Json                    @default("{}")
	createdAt    DateTime                @default(now())
	updatedAt    DateTime                @updatedAt
	owner        User?                   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
	messages     ChannelMessage[]

	@@unique([ownerUserId, provider, handle])
	@@index([provider, status])
}

enum ChannelMessageDirection {
	inbound
	outbound
}

model ChannelMessage {
	id                String                  @id @default(uuid())
	connectedAccountId String?
	ownerUserId       String?
	provider          String
	externalId        String
	direction         ChannelMessageDirection
	threadId          String?
	senderHandle      String
	recipientHandle   String?
	body              String?
	media             Json                    @default("[]")
	raw               Json                    @default("{}")
	occurredAt        DateTime
	processedAt       DateTime?
	createdAt         DateTime                @default(now())
	connectedAccount  ConnectedAccount?       @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
	owner             User?                   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

	@@unique([provider, externalId])
	@@index([ownerUserId, occurredAt])
	@@index([provider, threadId])
}


model AgentRunReceipt {
	id           String    @id @default(uuid())
	ownerUserId  String?
	agentKind    String
